generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String                    @unique
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  image               String?
  name                String
  emailVerified       Boolean                   @default(false) @map("email_verified")
  accounts            Account[]
  stageMovements      ApplicationStageHistory[] @relation("StageMovedBy")
  applicationsCreated Application[]             @relation("ApplicationCreatedBy")
  candidatesCreated   Candidate[]               @relation("CandidateCreatedBy")
  candidatesUpdated   Candidate[]               @relation("CandidateUpdatedBy")
  candidates          Candidate[]               @relation("CandidateAuthUser")
  jobPostingsCreated  JobPosting[]              @relation("JobPostingCreatedBy")
  jobPostingsUpdated  JobPosting[]              @relation("JobPostingUpdatedBy")
  sessions            Session[]
  memberships         TenantMembership[]

  @@map("users")
}

model Session {
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  id         String   @id

  @@index([identifier])
  @@map("verification")
}

enum TenantMembershipStatus {
  ACTIVE
  INACTIVE

  @@map("tenant_membership_status")
}

model TenantMembership {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  status          TenantMembershipStatus @default(ACTIVE)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipRoles   MembershipRole[]
  hiringTeamMembers HiringTeamMember[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model MembershipRole {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  tenantMembershipId String           @map("tenant_membership_id") @db.Uuid
  roleId             String           @map("role_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership         TenantMembership @relation(fields: [tenantId, tenantMembershipId], references: [tenantId, id], onDelete: Cascade)
  role               Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantMembershipId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("membership_roles")
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  name            String
  systemKey       String?          @map("system_key")
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([tenantId, name])
  @@unique([tenantId, systemKey])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @unique
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Candidate {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  authUserId       String?                 @map("auth_user_id") @db.Uuid
  name             String
  firstName        String                  @map("first_name")
  lastName         String?                 @map("last_name")
  email            String
  emailNormalized  String                  @map("email_normalized")
  phone            String?
  phoneNormalized  String?                 @map("phone_normalized")
  status           CandidateStatus         @default(ACTIVE)
  sourceId         String?                 @map("source_id") @db.Uuid
  cvUrl            String?                 @map("cv_url")
  cvRaw            String?                 @map("cv_raw")
  cvParsedData     Json?                   @map("cv_parsed_data")
  cvParsedAt       DateTime?               @map("cv_parsedAt") @db.Timestamptz(6)
  dataCompleteness Int                     @default(0) @map("data_completeness")
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamptz(6)
  createdById      String?                 @map("created_by_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedById      String?                 @map("updated_by_id") @db.Uuid
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authUser         User?                   @relation("CandidateAuthUser", fields: [authUserId], references: [id], onDelete: SetNull)
  applications              Application[]           @relation("ApplicationCandidateExistence")
  tenantScopedApplications  Application[]           @relation("ApplicationCandidateTenantScoped")
  leads            CandidateLead[]
  provenance       DataProvenance[]
  privacyAcks      PrivacyAcknowledgment[]
  createdBy        User?                   @relation("CandidateCreatedBy", fields: [createdById], references: [id])
  source           ApplicationSource?      @relation("CandidateSource", fields: [sourceId], references: [id])
  updatedBy        User?                   @relation("CandidateUpdatedBy", fields: [updatedById], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, authUserId])
  @@index([tenantId])
  @@index([tenantId, emailNormalized])
  @@index([tenantId, phoneNormalized])
  @@index([sourceId])
  @@map("candidates")
}

model DataProvenance {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  candidateId String    @map("candidate_id") @db.Uuid
  source      String
  channel     String
  collectedAt DateTime  @default(now()) @map("collected_at") @db.Timestamptz(6)

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate   Candidate @relation(fields: [tenantId, candidateId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, candidateId])
  @@map("data_provenance")
}

model PrivacyPolicyVersion {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  version         String
  content         String
  publishedAt     DateTime?               @map("published_at") @db.Timestamptz(6)
  isActive        Boolean                 @default(false) @map("is_active")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  acknowledgments PrivacyAcknowledgment[]

  @@unique([tenantId, id])
  @@unique([tenantId, version])
  @@index([tenantId, isActive])
  @@map("privacy_policy_versions")
}

model PrivacyAcknowledgment {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  candidateId     String               @map("candidate_id") @db.Uuid
  policyVersionId String               @map("policy_version_id") @db.Uuid
  acknowledgedAt  DateTime             @default(now()) @map("acknowledged_at") @db.Timestamptz(6)

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate       Candidate            @relation(fields: [tenantId, candidateId], references: [tenantId, id], onDelete: Cascade)
  policyVersion   PrivacyPolicyVersion @relation(fields: [tenantId, policyVersionId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, candidateId])
  @@index([tenantId, policyVersionId])
  @@map("privacy_acknowledgments")
}

model CandidateLead {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId String            @map("candidate_id") @db.Uuid
  sourceId    String            @map("source_id") @db.Uuid
  notes       String?
  status      LeadStatus        @default(NEW)
  convertedAt DateTime?         @map("converted_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  candidate   Candidate         @relation(fields: [candidateId], references: [id])
  source      ApplicationSource @relation("LeadSource", fields: [sourceId], references: [id])

  @@index([candidateId])
  @@index([sourceId])
  @@map("candidate_leads")
}

model Application {
  id                        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                  String?                   @map("tenant_id") @db.Uuid
  candidateId               String                    @map("candidate_id") @db.Uuid
  jobPostingId              String?                   @map("job_posting_id") @db.Uuid
  vacancyId                 String?                   @map("vacancy_id") @db.Uuid
  sourceId                  String?                   @map("source_id") @db.Uuid
  stageId                   String?                   @map("stage_id") @db.Uuid
  currentStageId            String?                   @map("current_stage_id") @db.Uuid
  outcome                   ApplicationOutcome        @default(NONE)
  assignedVacancyLocationId String?                   @map("assigned_vacancy_location_id") @db.Uuid
  appliedAt                 DateTime                  @default(now()) @map("applied_at") @db.Timestamptz(6)
  notes                     String?
  createdById               String?                   @map("created_by_id") @db.Uuid
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                              Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate                           Candidate                 @relation("ApplicationCandidateExistence", fields: [candidateId], references: [id], onDelete: Restrict)
  candidateTenantScoped               Candidate?                @relation("ApplicationCandidateTenantScoped", fields: [tenantId, candidateId], references: [tenantId, id], onDelete: Restrict)
  jobPosting                          JobPosting?               @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  vacancy                             Vacancy?                  @relation("ApplicationVacancyExistence", fields: [vacancyId], references: [id], onDelete: Restrict)
  vacancyTenantScoped                 Vacancy?                  @relation("ApplicationVacancyTenantScoped", fields: [tenantId, vacancyId], references: [tenantId, id], onDelete: Restrict)
  source                              ApplicationSource?        @relation("ApplicationSourceRelation", fields: [sourceId], references: [id])
  stage                               PipelineStage?            @relation("LegacyApplicationStage", fields: [stageId], references: [id], onDelete: Restrict)
  currentStage                        PipelineStage?            @relation("ApplicationCurrentStage", fields: [currentStageId], references: [id], onDelete: Restrict)
  assignedVacancyLocation             VacancyLocation?          @relation("ApplicationAssignedLocationExistence", fields: [assignedVacancyLocationId], references: [id], onDelete: Restrict)
  assignedVacancyLocationTenantScoped VacancyLocation?          @relation("ApplicationAssignedLocationTenantScoped", fields: [tenantId, vacancyId, assignedVacancyLocationId], references: [tenantId, vacancyId, id], onDelete: Restrict)
  createdBy                           User?                     @relation("ApplicationCreatedBy", fields: [createdById], references: [id])
  histories                           ApplicationStageHistory[] @relation("StageHistoryApplicationExistence")
  tenantScopedHistories               ApplicationStageHistory[] @relation("StageHistoryApplicationTenantScoped")
  interviews                          Interview[]

  @@unique([candidateId, jobPostingId])
  @@unique([tenantId, id])
  @@unique([tenantId, candidateId, vacancyId], where: { outcome: "NONE" }, map: "applications_active_tenant_candidate_vacancy_key")
  @@index([tenantId])
  @@index([tenantId, vacancyId])
  @@index([tenantId, candidateId])
  @@index([tenantId, currentStageId])
  @@index([tenantId, outcome])
  @@index([vacancyId])
  @@index([currentStageId])
  @@index([assignedVacancyLocationId])
  @@index([jobPostingId, stageId])
  @@index([candidateId])
  @@index([jobPostingId])
  @@index([sourceId])
  @@index([stageId])
  @@index([appliedAt])
  @@map("applications")
}

model ApplicationSource {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  type         SourceType
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  applications Application[]   @relation("ApplicationSourceRelation")
  leads        CandidateLead[] @relation("LeadSource")
  candidates   Candidate[]     @relation("CandidateSource")

  @@index([type, isActive])
  @@map("application_sources")
}

model JobPosting {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  slug             String             @unique
  description      String
  responsibilities String?
  requirements     String?
  benefits         String?
  metaTitle        String?            @map("meta_title")
  metaDescription  String?            @map("meta_description")
  noIndex          Boolean            @default(false) @map("no_index")
  categoryId       String             @map("category_id") @db.Uuid
  departmentId     String?            @map("department_id") @db.Uuid
  pipelineId       String             @map("pipeline_id") @db.Uuid
  employmentType   EmploymentType     @map("employment_type")
  seniorityLevel   SeniorityLevel?    @map("seniority_level")
  salaryMin        Decimal?           @map("salary_min") @db.Decimal(10, 2)
  salaryMax        Decimal?           @map("salary_max") @db.Decimal(10, 2)
  salaryCurrency   String?            @map("salary_currency")
  applyUrl         String?            @map("apply_url")
  isRemote         Boolean            @default(false) @map("is_remote")
  status           JobStatus          @default(DRAFT)
  totalPositions   Int?               @map("total_positions")
  positionsFilled  Int                @default(0) @map("positions_filled")
  publishedAt      DateTime?          @map("published_at") @db.Timestamptz(6)
  validThrough     DateTime?          @map("valid_through") @db.Timestamptz(6)
  organizationId   String?            @map("organization_id") @db.Uuid
  createdById      String?            @map("created_by_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedById      String?            @map("updated_by_id") @db.Uuid
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  applications     Application[]
  category         JobCategory        @relation(fields: [categoryId], references: [id])
  createdBy        User?              @relation("JobPostingCreatedBy", fields: [createdById], references: [id])
  department       Department?        @relation(fields: [departmentId], references: [id])
  organization     Organization?      @relation(fields: [organizationId], references: [id])
  pipeline         HiringPipeline     @relation(fields: [pipelineId], references: [id])
  updatedBy        User?              @relation("JobPostingUpdatedBy", fields: [updatedById], references: [id])

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, validThrough])
  @@index([organizationId, status, publishedAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([departmentId, status])
  @@index([pipelineId])
  @@map("job_postings")
}

model Department {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String
  slug        String
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  jobPostings JobPosting[]
  vacancies   Vacancy[]

  @@unique([tenantId, slug])
  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("departments")
}

model Tenant {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  slug          String        @unique
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  legalEntities    LegalEntity[]
  locations        Location[]
  departments      Department[]
  roles            Role[]
  memberships      TenantMembership[]
  pipelines        HiringPipeline[]
  pipelineVersions PipelineVersion[]
  vacancies             Vacancy[]
  candidates            Candidate[]
  dataProvenances       DataProvenance[]
  privacyPolicyVersions PrivacyPolicyVersion[]
  privacyAcknowledgments PrivacyAcknowledgment[]
  applications          Application[]
  applicationStageHistories ApplicationStageHistory[]

  @@map("tenants")
}

model LegalEntity {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  name      String
  code      String?    @map("code")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  locations Location[]
  vacancies Vacancy[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("legal_entities")
}

model Location {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  legalEntityId    String            @map("legal_entity_id") @db.Uuid
  name             String
  code             String?           @map("code")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  legalEntity      LegalEntity       @relation(fields: [tenantId, legalEntityId], references: [tenantId, id], onDelete: Restrict)
  vacancyLocations VacancyLocation[]

  @@unique([tenantId, legalEntityId, name])
  @@unique([tenantId, legalEntityId, id])
  @@index([tenantId])
  @@index([legalEntityId])
  @@map("locations")
}

model Organization {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  website     String?
  logoUrl     String?      @map("logo_url")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  jobPostings JobPosting[]

  @@map("organizations")
}

model JobCategory {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String       @unique
  metaTitle       String?      @map("meta_title")
  metaDescription String?      @map("meta_description")
  jobPostings     JobPosting[]

  @@map("job_categories")
}

model HiringPipeline {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  name        String
  isDefault   Boolean           @default(false) @map("is_default")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  versions    PipelineVersion[]
  jobPostings JobPosting[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("hiring_pipelines")
}

model PipelineVersion {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  pipelineId  String                @map("pipeline_id") @db.Uuid
  version     Int
  status      PipelineVersionStatus @default(DRAFT)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime?             @map("published_at") @db.Timestamptz(6)

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  pipeline    HiringPipeline        @relation(fields: [tenantId, pipelineId], references: [tenantId, id], onDelete: Cascade)
  stages      PipelineStage[]
  vacancies   Vacancy[]

  @@unique([pipelineId, version])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([pipelineId])
  @@map("pipeline_versions")
}

model PipelineStage {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineVersionId  String                    @map("pipeline_version_id") @db.Uuid
  name               String
  category           StageCategory
  order              Int
  isInitial          Boolean                   @default(false) @map("is_initial")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  version            PipelineVersion           @relation(fields: [pipelineVersionId], references: [id], onDelete: Cascade)
  fromStageHistories ApplicationStageHistory[] @relation("FromStage")
  toStageHistories   ApplicationStageHistory[] @relation("ToStage")
  applications       Application[]             @relation("LegacyApplicationStage")
  canonicalApplications Application[]          @relation("ApplicationCurrentStage")
  interviews         Interview[]

  @@unique([pipelineVersionId, order])
  @@index([pipelineVersionId])
  @@map("pipeline_stages")
}

model Vacancy {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  departmentId      String            @map("department_id") @db.Uuid
  legalEntityId     String            @map("legal_entity_id") @db.Uuid
  pipelineVersionId String            @map("pipeline_version_id") @db.Uuid
  title             String
  slug              String
  description       String?
  employmentType    EmploymentType?   @map("employment_type")
  isRemote          Boolean           @default(false) @map("is_remote")
  openings          Int               @default(1)
  status            VacancyStatus     @default(DRAFT)
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department        Department        @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  legalEntity       LegalEntity       @relation(fields: [tenantId, legalEntityId], references: [tenantId, id], onDelete: Restrict)
  pipelineVersion   PipelineVersion   @relation(fields: [tenantId, pipelineVersionId], references: [tenantId, id], onDelete: Restrict)
  locations         VacancyLocation[]
  hiringTeamMembers HiringTeamMember[]
  applications              Application[]        @relation("ApplicationVacancyExistence")
  tenantScopedApplications  Application[]        @relation("ApplicationVacancyTenantScoped")

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@unique([tenantId, id, legalEntityId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([departmentId])
  @@index([legalEntityId])
  @@index([pipelineVersionId])
  @@map("vacancies")
}

model VacancyLocation {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  vacancyId     String      @map("vacancy_id") @db.Uuid
  legalEntityId String      @map("legal_entity_id") @db.Uuid
  locationId    String      @map("location_id") @db.Uuid
  openings      Int
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  vacancy       Vacancy     @relation(fields: [tenantId, vacancyId, legalEntityId], references: [tenantId, id, legalEntityId], onDelete: Cascade)
  location      Location    @relation(fields: [tenantId, legalEntityId, locationId], references: [tenantId, legalEntityId, id], onDelete: Restrict)
  applications              Application[]    @relation("ApplicationAssignedLocationExistence")
  tenantScopedApplications  Application[]    @relation("ApplicationAssignedLocationTenantScoped")

  @@unique([vacancyId, locationId])
  @@unique([tenantId, vacancyId, id])
  @@index([tenantId])
  @@index([vacancyId])
  @@index([locationId])
  @@map("vacancy_locations")
}

model HiringTeamMember {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  vacancyId          String           @map("vacancy_id") @db.Uuid
  tenantMembershipId String           @map("tenant_membership_id") @db.Uuid
  responsibility     HiringTeamRole
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  vacancy            Vacancy          @relation(fields: [tenantId, vacancyId], references: [tenantId, id], onDelete: Cascade)
  membership         TenantMembership @relation(fields: [tenantId, tenantMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([vacancyId, tenantMembershipId])
  @@index([tenantId])
  @@index([vacancyId])
  @@index([tenantMembershipId])
  @@map("hiring_team_members")
}

model ApplicationStageHistory {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String?        @map("tenant_id") @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  fromStageId   String?        @map("from_stage_id") @db.Uuid
  toStageId     String         @map("to_stage_id") @db.Uuid
  movedAt       DateTime       @default(now()) @map("moved_at") @db.Timestamptz(6)
  notes         String?
  movedById     String?        @map("moved_by_id") @db.Uuid

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application               Application    @relation("StageHistoryApplicationExistence", fields: [applicationId], references: [id], onDelete: Restrict)
  applicationTenantScoped   Application?   @relation("StageHistoryApplicationTenantScoped", fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict)
  fromStage     PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id])
  movedBy       User?          @relation("StageMovedBy", fields: [movedById], references: [id])
  toStage       PipelineStage  @relation("ToStage", fields: [toStageId], references: [id])

  @@index([tenantId])
  @@index([tenantId, applicationId])
  @@index([applicationId, movedAt])
  @@index([applicationId])
  @@index([toStageId])
  @@index([fromStageId])
  @@map("application_stage_history")
}

model Interview {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String          @map("application_id") @db.Uuid
  stageId       String?         @map("stage_id") @db.Uuid
  type          InterviewType
  status        InterviewStatus
  scheduledAt   DateTime?       @map("scheduled_at") @db.Timestamptz(6)
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz(6)
  location      String?
  meetingUrl    String?         @map("meeting_url")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  application   Application     @relation(fields: [applicationId], references: [id])
  stage         PipelineStage?  @relation(fields: [stageId], references: [id])

  @@index([applicationId])
  @@index([stageId])
  @@map("interviews")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  action    String
  userId    String?  @map("user_id") @db.Uuid
  ip        String?
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entity, entityId])
  @@index([entity, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

